# PointCV Backend - production environment template.
# Copy to `.env.production` (or the Docker secret manager of your platform)
# and fill in real values. NEVER commit the real file.

# Application.
APP_NAME=PointCV API
DEBUG=false

# Neon PostgreSQL (prod). Overridden by docker-compose in self-hosting.
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db:5432/pointcv

# Better Auth (shared JWT secret + frontend URL).
# BETTER_AUTH_SECRET must match the frontend's BETTER_AUTH_SECRET exactly.
BETTER_AUTH_SECRET=generate_with_openssl_rand_-base64_32
BETTER_AUTH_URL=https://pointcv.vercel.app

# Midtrans (production).
MIDTRANS_SERVER_KEY=Mid-server-xxx
MIDTRANS_CLIENT_KEY=Mid-client-xxx
MIDTRANS_IS_PRODUCTION=true

# Cloudflare R2.
R2_ENDPOINT_URL=https://xxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=pointcv-files
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=https://pointcv.id,https://www.pointcv.id

# Optional: gunicorn worker count / log level overrides.
# WEB_CONCURRENCY=4
# LOG_LEVEL=info
