# Backend application name.
APP_NAME=

# Enable debug logging and FastAPI debug mode.
DEBUG=

# Async SQLAlchemy database URL.
DATABASE_URL=

# Clerk backend secret key.
CLERK_SECRET_KEY=

# Clerk JWKS endpoint for JWT verification.
CLERK_JWKS_URL=

# Midtrans server key for payment API requests.
MIDTRANS_SERVER_KEY=

# Midtrans client key for Snap integration.
MIDTRANS_CLIENT_KEY=

# Set true for Midtrans production mode.
MIDTRANS_IS_PRODUCTION=

# Cloudflare R2 S3-compatible endpoint URL.
R2_ENDPOINT_URL=

# Cloudflare R2 access key ID.
R2_ACCESS_KEY_ID=

# Cloudflare R2 secret access key.
R2_SECRET_ACCESS_KEY=

# Cloudflare R2 bucket name.
R2_BUCKET_NAME=

# Public base URL for files served from R2.
R2_PUBLIC_URL=

# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=
