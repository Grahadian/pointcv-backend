# PointCV Backend — environment template.
# Copy to `.env` for local dev (or set in your Render dashboard) and fill in
# real values. NEVER commit the real file.

# --- Application ---------------------------------------------------------
APP_NAME=PointCV API
DEBUG=false

# --- Database ------------------------------------------------------------
# Production (Render): Neon PostgreSQL. Use the plain postgresql:// URL — the
# app auto-converts it to postgresql+asyncpg:// at runtime and to
# postgresql+psycopg2:// for Alembic migrations.
#   postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
#
# Local dev only (when unset, the app falls back to a local SQLite file):
#   sqlite+aiosqlite:///./pointcv.db
DATABASE_URL=

# --- Better Auth (must match the Next.js frontend) -----------------------
# Shared HS256 JWT secret. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Base URL of the frontend app (JWT issuer/audience).
BETTER_AUTH_URL=http://localhost:3000

# --- CORS ----------------------------------------------------------------
# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Midtrans ------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Cloudflare R2 -------------------------------------------------------
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pointcv-files
R2_PUBLIC_URL=

# --- Server (optional overrides) -----------------------------------------
# Render sets PORT itself (defaults to 10000).
# PORT=10000
# WEB_CONCURRENCY=1
# LOG_LEVEL=info
# Connection pool tuning (defaults are Neon-free-tier friendly).
# PG_POOL_SIZE=5
# PG_MAX_OVERFLOW=10
